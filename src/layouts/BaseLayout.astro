---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME, SITE_SUBTITLE, sitePath } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: URL;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  canonical: _requestedCanonical = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
  jsonLd,
  noindex: _requestedNoindex = false
} = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const migratedPath = Astro.url.pathname.replace(/^\/stream-archive-verification(?=\/|$)/, '') || '/';
const canonical = new URL(migratedPath, 'https://vtuberkenkyulab-cell.github.io');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${canonical.href}`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={new URL(sitePath('/rss.xml'), Astro.site)} />
    <link rel="sitemap" href={new URL(sitePath('/sitemap-index.xml'), Astro.site)} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {verification && <meta name="google-site-verification" content={verification} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <p class="migration-notice">サイトを移転しました。<a href={canonical}>新しいページへ移動する</a></p>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={sitePath('/')}>
          <strong>{SITE_NAME}</strong>
          <span>{SITE_SUBTITLE}</span>
        </a>
        <nav class="nav" aria-label="主要ナビゲーション">
          <a href={sitePath('/articles/')}>記事一覧</a>
          <a href={sitePath('/people/')}>人物から探す</a>
          <a href={sitePath('/methodology/')}>調査方法</a>
          <a href={sitePath('/about/')}>サイトについて</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-links">
          <a href={sitePath('/editorial-policy/')}>編集方針</a>
          <a href={sitePath('/sources/')}>情報源の考え方</a>
          <a href={sitePath('/corrections/')}>訂正・更新履歴</a>
          <a href={sitePath('/contact/')}>訂正依頼・問い合わせ</a>
          <a href={sitePath('/rss.xml')}>RSS</a>
        </div>
        <p class="disclosure">本サイトは非公式の検証アーカイブです。公開情報をもとに作成しており、対象人物・所属事務所との公式な関係を示すものではありません。</p>
        <small>© {new Date().getFullYear()} {SITE_NAME}</small>
      </div>
    </footer>
  </body>
</html>
